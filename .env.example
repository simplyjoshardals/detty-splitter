# Copy to .env.local for local development.
# Every NEXT_PUBLIC_* value is inlined into the client bundle at build time,
# so it is PUBLIC. Never put a secret or tokenized URL here.
# Changing a value means rebuilding / redeploying, it is not a live toggle.

# Show the CTA card only when this is exactly "true".
NEXT_PUBLIC_CTA_ENABLED=false

# Must be a valid https:// URL, otherwise the CTA card stays hidden.
NEXT_PUBLIC_CTA_URL=

# The title, button text and disclosure line are plain constants in config/index.ts.